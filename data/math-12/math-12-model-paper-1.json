    {
      "id": 2,
      "question": "If f(x) = 2x + 7, then the inverse f⁻¹(x) is:",
      "options": {
        "A": "(x - 7)/2",
        "B": "(x + 7)/2",
        "C": "2x - 7",
        "D": "1/(2x + 7)"
      },
      "correctAnswer": "A",
      "explanation": "y = 2x + 7 ⇒ 2x = y - 7 ⇒ x = (y - 7)/2 ⇒ f⁻¹(x) = (x - 7)/2."
    },
